---
import type { CollectionEntry } from "astro:content";
import { useTranslations, type Locale } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
  home: CollectionEntry<"home">["data"];
  settings: CollectionEntry<"settings">["data"];
}

const { locale, home, settings } = Astro.props;
const t = useTranslations(locale);
const { available, note } = settings.availability;
---

<section id="top" class="mx-auto max-w-5xl px-4 py-20 md:py-32">
  <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 text-sm text-muted">
    <span class:list={["size-2 rounded-full", available ? "bg-green-500" : "bg-amber-500"]} aria-hidden="true"></span>
    {t(available ? "availability.on" : "availability.off")}
    {note?.[locale] && <span>· {note[locale]}</span>}
  </p>
  <h1 class="max-w-3xl text-4xl leading-tight font-bold text-balance md:text-6xl">{home.headline[locale]}</h1>
  <p class="mt-6 max-w-2xl text-lg text-muted md:text-xl">{home.subline[locale]}</p>
  <div class="mt-10 flex flex-wrap gap-3">
    <a
      href={`https://wa.me/${settings.contact.whatsapp}`}
      class="inline-flex items-center gap-2 rounded-lg bg-accent px-5 py-3 font-semibold text-accent-text"
    >
      <Icon name="brand:whatsapp" />
      {t("hero.cta")}
    </a>
    <a href="#work" class="inline-flex items-center rounded-lg border border-line px-5 py-3 font-semibold hover:bg-surface">
      {t("hero.secondary")}
    </a>
  </div>
</section>
