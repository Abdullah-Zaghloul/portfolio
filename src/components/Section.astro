---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-line py-16 md:py-24">
  <div class="mx-auto max-w-5xl px-4">
    <h2 id={`${id}-title`} class="mb-10 text-2xl font-bold md:text-3xl">{title}</h2>
    <slot />
  </div>
</section>
