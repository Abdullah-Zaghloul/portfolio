---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { useTranslations, type Locale } from "../i18n/ui";
import About from "./About.astro";
import Contact from "./Contact.astro";
import Experience from "./Experience.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import Projects from "./Projects.astro";
import Services from "./Services.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const settings = (await getEntry("settings", "site"))!.data;
const home = (await getEntry("home", "home"))!.data;
const name = settings.name[locale];
---

<Base locale={locale} title={t("meta.title")} description={home.subline[locale]} path="">
  <Header locale={locale} name={name} />
  <main id="main">
    <Hero locale={locale} home={home} settings={settings} />
    <Services locale={locale} />
    <Projects locale={locale} />
    <Experience locale={locale} />
    <About locale={locale} home={home} name={name} />
    <Contact locale={locale} settings={settings} />
  </main>
  <Footer locale={locale} name={name} github={settings.contact.github} />
</Base>
