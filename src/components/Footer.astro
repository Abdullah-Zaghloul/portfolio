---
import { useTranslations, type Locale } from "../i18n/ui";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
  name: string;
  github: string;
}

const { locale, name, github } = Astro.props;
const t = useTranslations(locale);
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-4 px-4 py-8 text-sm text-muted">
    <p>© {new Date().getFullYear()} {name}</p>
    <a href={`${github}/portfolio`} class="hover:text-text">{t("footer.source")}</a>
    <a href="#top" class="ms-auto inline-flex items-center gap-1 hover:text-text">
      {t("footer.top")}
      <Icon name="lucide:arrow-up" size={16} />
    </a>
  </div>
</footer>
